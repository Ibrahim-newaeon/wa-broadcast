# ─── WhatsApp Cloud API ──────────────────────────────────────────────
# From Meta App Dashboard → WhatsApp → API Setup
GRAPH_API_VERSION=v21.0
WA_PHONE_NUMBER_ID=000000000000000
WA_BUSINESS_ACCOUNT_ID=000000000000000
WA_ACCESS_TOKEN=EAAG...your-permanent-system-user-token
META_APP_SECRET=your-app-secret          # used to verify webhook signatures
WA_WEBHOOK_VERIFY_TOKEN=choose-a-long-random-string

# Throughput cap (messages/sec). Default tier = 80. Raise only after Meta upgrade.
WA_MPS=80

# Comma-separated inbound keywords that trigger opt-out (case-insensitive)
OPT_OUT_KEYWORDS=STOP,UNSUBSCRIBE,الغاء

# ─── Infrastructure ──────────────────────────────────────────────────
DATABASE_URL=postgresql://wa:wa_password@postgres:5432/wa_broadcast?schema=public
REDIS_URL=redis://redis:6379

# ─── Auth (admin login) ──────────────────────────────────────────────
# Single admin user. Generate the hash: node scripts/hash-password.mjs 'YourPassword'
AUTH_JWT_SECRET=generate-a-64-char-random-string-here-min-32-chars
ADMIN_EMAIL=abd.rabo.940@gmail.com
ADMIN_PASSWORD_HASH=$2a$12$replace.with.bcrypt.hash.from.script
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
LOGIN_RATE_MAX=5
LOGIN_RATE_WINDOW=300

# ─── App ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
