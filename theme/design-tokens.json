{
  "name": "Broadcast Hub",
  "brand": "NazzilVideo",
  "description": "Design tokens for the WhatsApp Broadcast Hub. Dark theme, teal/green brand, bilingual EN/AR. Live stylesheet: src/app/globals.css.",
  "color": {
    "bg": "#06140d", "bg2": "#04100a", "card": "#0c1f16", "card2": "#11291d",
    "line": "#1c3b2b", "line2": "#275038",
    "ink": "#eafff4", "muted": "#8fb1a1",
    "teal": "#25d366", "tealHover": "#3fe07f", "tealSoft": "rgba(37,211,102,0.12)",
    "green": "#46e08a", "orange": "#fb7a1e", "danger": "#ff6b6b", "btnText": "#04140c"
  },
  "status": {
    "PENDING": "#90a6b4",
    "SENT": "#5ac8ff",
    "DELIVERED": "#2dd4c4",
    "READ": "#46e08a",
    "FAILED": "#ff6b6b",
    "SCHEDULED": "#c9a227",
    "SENDING": "#2dd4c4",
    "COMPLETED": "#46e08a"
  },
  "gradient": { "brand": "linear-gradient(120deg, #25d366, #0fae8b)" },
  "font": {
    "en": "\"Inter\", system-ui, -apple-system, \"Segoe UI\", sans-serif",
    "ar": "\"Cairo\", \"Segoe UI Arabic\", \"Tahoma\", sans-serif",
    "weights": [400, 500, 600, 700, 800]
  },
  "radius": { "base": "14px", "sm": "10px", "pill": "999px", "logo": "7px" },
  "layout": { "maxWidth": "1180px", "navHeight": "62px" },
  "shadow": "0 10px 30px rgba(0,0,0,0.35)",
  "typeScale": {
    "h1": "clamp(26px, 4vw, 40px)",
    "h2": "clamp(20px, 3vw, 28px)",
    "h3": "17px",
    "body": "16px",
    "small": "12px"
  },
  "components": {
    "button": "pill, WhatsApp green→teal gradient, #04140c text, 48px min-height",
    "badge": "pill outline, color = status token",
    "input": "bg2 fill, line2 border, green focus ring (16% accent)",
    "card": "card fill, line border, radius 14, soft shadow",
    "progress": "12px track, brand gradient bar",
    "touchTarget": "44px minimum (mobile-first)"
  }
}
